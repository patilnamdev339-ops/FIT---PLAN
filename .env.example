# =============================================================================
# FitPlan — Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to version control!
# =============================================================================

# --- Flask Backend Configuration ---
FLASK_ENV=development
FLASK_DEBUG=0
PORT=5000
SECRET_KEY=replace-with-a-long-random-cryptographic-secret-key-min-32-chars

# --- MySQL Database Configuration ---
# Set DB_ENGINE=mysql to connect to MySQL Server (recommended for production & MySQL Workbench)
# Set DB_ENGINE=sqlite only if running local offline tests without a MySQL server installed
DB_ENGINE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=fitplan_db

# Optional full SQLAlchemy URI override (if using a managed cloud MySQL URL like Aiven/Railway/PlanetScale):
# DATABASE_URL=mysql+pymysql://user:password@host:3306/fitplan_db

# --- Security & CORS Configuration ---
FRONTEND_ORIGIN=http://localhost:8443
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_HOURS=168

# --- Optional AI Food Photo Scanner ---
# If omitted, the backend uses a deterministic nutrition estimation fallback
OPENAI_API_KEY=

# --- Frontend (Vite) Configuration ---
VITE_API_URL=/api

# --- Firebase Authentication Configuration (Optional / Client-side) ---
# Can be configured here or entered directly in the UI via the "Connect Firebase Authentication" modal
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

